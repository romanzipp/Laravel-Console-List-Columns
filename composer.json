{
    "name": "romanzipp/laravel-console-list-columns",
    "description": "List database tables columns & information.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "romanzipp",
            "email": "ich@ich.wtf",
            "homepage": "https://ich.wtf"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/emoji": "^4.2",
        "symfony/console": "^7.0|^8.0",
        "wujunze/php-cli-color": "^2.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0|^13.0",
        "romanzipp/php-cs-fixer-config": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "romanzipp\\ColumnList\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "romanzipp\\ColumnList\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "romanzipp\\ColumnList\\Providers\\ColumnListProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
